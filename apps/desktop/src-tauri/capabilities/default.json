{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum permissions for the main window: core window/event basics plus explicit application commands. No shell, no fs plugin, no remote origins.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "allow-get-app-info",
    "allow-get-config",
    "allow-set-mode",
    "allow-update-settings",
    "allow-get-core-status",
    "allow-test-relay-connection",
    "allow-log-ui-error",
    "allow-login",
    "allow-register-account",
    "allow-logout",
    "allow-get-login-state",
    "allow-driver-start-streaming",
    "allow-driver-stop-streaming",
    "allow-driver-end-session",
    "allow-driver-new-code",
    "allow-driver-kick-engineer",
    "allow-driver-set-recording",
    "allow-driver-add-marker",
    "allow-driver-ack-alert",
    "allow-engineer-join",
    "allow-engineer-confirm",
    "allow-engineer-cancel",
    "allow-engineer-disconnect",
    "allow-engineer-request-snapshot",
    "allow-demo-start",
    "allow-demo-stop",
    "allow-bridge-subscribe",
    "allow-bridge-unsubscribe",
    "allow-pick-motec-file",
    "allow-restart-app"
  ]
}
