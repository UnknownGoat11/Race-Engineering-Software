# lmu-relay configuration (copy to relay.env; every option can also be passed as a
# `lmu-relay serve --flag`, see `lmu-relay serve --help`). Never commit relay.env.

# development | staging | production. Announced in HELLO; production clients refuse any other.
# Only development may run without DATABASE_URL (in-memory store), JWT_KEY_FILE or ADMIN_TOKEN.
RELAY_ENV=production

# Telemetry listener (TLS 1.3, ALPN lmure/1). docker-compose sets RELAY_PORT=8443 and publishes 443.
# Per-IP limits need the clients' real addresses: with the bundled docker-compose.yml publish no
# AAAA record for the relay hostname unless IPv6 is enabled end to end (see "Client addresses
# and IPv6" in docker-compose.yml; then use RELAY_BIND=::).
RELAY_BIND=0.0.0.0
# RELAY_PORT=443

# PEM certificate chain and private key; reloaded automatically when the files change.
TLS_CERT=/etc/lmu-relay/tls/fullchain.pem
TLS_KEY=/etc/lmu-relay/tls/privkey.pem
# TLS_RELOAD_INTERVAL_S=30

# PostgreSQL (docker-compose builds DATABASE_URL from POSTGRES_PASSWORD in deploy/.env).
# DATABASE_URL=postgres://relay:password@postgres:5432/relay
# DATABASE_MAX_CONNECTIONS=10
# Migrations run at startup unless disabled (then run `lmu-relay migrate`).
# RELAY_NO_MIGRATE=false

# Ed25519 signing key of access tokens (create once with `lmu-relay gen-jwt-key --out <file>`).
# Replacing it invalidates access tokens only; clients re-authenticate with their refresh token.
JWT_KEY_FILE=/run/secrets/jwt.key

# Admin listener (/health, /metrics) and its bearer token: required outside development, at
# least 32 characters, e.g. `openssl rand -hex 32`. Left empty, the relay refuses to start (no
# guessable default). ADMIN_BIND=off disables the listener.
ADMIN_BIND=127.0.0.1:9090
ADMIN_TOKEN=

# Open self-registration (ACCOUNT_REGISTER). Off by default: accounts come from `create-user`.
RELAY_OPEN_REGISTRATION=false

# Logs: json (default) | pretty; level filter via RUST_LOG (e.g. info, lmu_relay=debug).
LOG_FORMAT=json
RUST_LOG=info

# --- Limits (defaults shown; generous headroom over a 100 Hz driver stream) ---
# RELAY_MAX_CONNECTIONS=2048
# RELAY_MAX_CONNECTIONS_PER_IP=32
# RELAY_MAX_SESSIONS=512
# Engineer slots per driver session (D-022).
# RELAY_MAX_ENGINEERS_PER_SESSION=2
# RELAY_MAX_PAYLOAD_BYTES=262144
# RELAY_CONNECTION_PACKETS_PER_SEC=2000
# RELAY_CONNECTION_BYTES_PER_SEC=8388608
# RELAY_SESSION_PACKETS_PER_SEC=3000
# RELAY_SESSION_BYTES_PER_SEC=12582912
# Invalid frames tolerated per connection (refilled 1/s) before it is closed.
# RELAY_MALFORMED_BUDGET=32
# SESSION_JOIN attempts per account and per IP (D-022: 5/min, 20/h).
# CODE_REDEMPTIONS_PER_MINUTE=5
# CODE_REDEMPTIONS_PER_HOUR=20
# AUTH_ATTEMPTS_PER_IP_PER_MINUTE=30
# AUTH_ATTEMPTS_PER_ACCOUNT_PER_MINUTE=10

# --- Timeouts and lifetimes (PROTOCOL.md §7 defaults) ---
# HEARTBEAT_INTERVAL_MS=1000
# HEARTBEAT_TIMEOUT_MS=5000
# SESSION_DRIVER_GRACE_S=600
# CONNECT_CODE_TTL_S=600
# ENGINEER_TICKET_TTL_S=600
# ACCESS_TOKEN_TTL_S=900
# Sliding refresh-token lifetime since last use (D-020).
# REFRESH_TOKEN_TTL_DAYS=90
# Open connections of a revoked login (`lmu-relay revoke-tokens`) are closed within this time.
# REVOCATION_CHECK_INTERVAL_S=30
